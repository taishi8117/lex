{
  "name": "lex-dictionary",
  "version": "1.0.0",
  "description": "Multi-source dictionary Chrome extension",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "build:safari": "tsc && vite build --config vite.config.safari.ts",
    "watch:safari": "vite build --config vite.config.safari.ts --watch",
    "ios:open": "open ios/Lex/Lex.xcodeproj"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@types/chrome": "^0.0.254",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
